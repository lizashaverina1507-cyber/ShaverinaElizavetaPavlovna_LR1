<Window x:Class="calcul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:calcul"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FFE68A2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF8C42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF2C5F8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A7BB0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF8B2C2C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB03A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FF2D2D2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Background="#FF1E1E1E" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="КАЛЬКУЛЯТОР" Foreground="White" FontWeight="Bold" 
                       Margin="10,8" FontSize="14"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,5">
                <RadioButton x:Name="SimpleModeRadio" Content="Обычный" 
                             GroupName="Mode" IsChecked="True" 
                             Foreground="White" Margin="5,0,10,0"
                             Checked="ModeRadio_Checked" FontSize="13"/>
                <RadioButton x:Name="EngineerModeRadio" Content="Инженерный" 
                             GroupName="Mode" IsChecked="False" 
                             Foreground="White" Margin="0,0,5,0"
                             Checked="ModeRadio_Checked" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Панель вывода - ВАЖНО: x:Name="InputBox" и x:Name="ResultBox" -->
        <Border Grid.Row="1" Background="#FF1E1E1E" Margin="10,5,10,5" 
                CornerRadius="8" BorderBrush="#FF555555" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox" Grid.Row="0" 
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FFCCCCCC" FontSize="18"
                         Text="" TextAlignment="Right"
                         IsReadOnly="True" Margin="10,10,10,5"
                         Height="35"/>

                <TextBox x:Name="ResultBox" Grid.Row="1" 
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="32" FontWeight="Bold"
                         Text="0" TextAlignment="Right"
                         IsReadOnly="True" Margin="10,5,10,10"
                         Height="55"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ButtonsGrid" Margin="10,5">
                <!-- Обычный режим -->
                <Grid x:Name="SimpleGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource ClearButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="⌫" Style="{StaticResource ClearButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="%" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="/" Style="{StaticResource OperatorButton}" Click="Button_Click"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="*" Style="{StaticResource OperatorButton}" Click="Button_Click"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="3" Content="-" Style="{StaticResource OperatorButton}" Click="Button_Click"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}" Click="Button_Click"/>

                    <Button Grid.Row="4" Grid.Column="0" Content="±" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="1" Content="0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="," Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                </Grid>

                <!-- Инженерный режим -->
                <Grid x:Name="EngineerGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="x²" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="√" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="1/x" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="xʸ" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="0" Grid.Column="4" Content="C" Style="{StaticResource ClearButton}" Click="Button_Click"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="sin" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="cos" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="tan" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="%" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="4" Content="⌫" Style="{StaticResource ClearButton}" Click="Button_Click"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="3" Content="/" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="2" Grid.Column="4" Content="(" Style="{StaticResource CalcButton}" Click="Button_Click"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="4" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="5" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="6" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="3" Content="*" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="3" Grid.Column="4" Content=")" Style="{StaticResource CalcButton}" Click="Button_Click"/>

                    <Button Grid.Row="4" Grid.Column="0" Content="1" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="1" Content="2" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="3" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="3" Content="-" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="4" Grid.Column="4" Content="=" Style="{StaticResource OperatorButton}" Click="Button_Click"/>

                    <Button Grid.Row="5" Grid.Column="0" Content="±" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="5" Grid.Column="1" Content="0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="5" Grid.Column="2" Content="," Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    <Button Grid.Row="5" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}" Click="Button_Click"/>
                    <Button Grid.Row="5" Grid.Column="4" Content="π" Style="{StaticResource FunctionButton}" Click="Button_Click"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Grid Grid.Row="3" Background="#FF1E1E1E" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button x:Name="ClearHistoryBtn" Content="Очистить историю" 
                        Style="{StaticResource ClearButton}" Width="120"
                        Click="ClearHistory_Click" Margin="3"/>
                <Button x:Name="ViewHistoryBtn" Content="Показать историю" 
                        Style="{StaticResource FunctionButton}" Width="120"
                        Click="ViewHistory_Click" Margin="3"/>
                <Button x:Name="ClearInputBtn" Content="Очистить ввод" 
                        Style="{StaticResource ClearButton}" Width="110"
                        Click="ClearInput_Click" Margin="3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>